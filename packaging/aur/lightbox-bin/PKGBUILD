# Maintainer: Lightbox contributors
# The release workflow fills pkgver and sha256sums, then pushes this file to the AUR.
# sha256sums stays SKIP in the git repo until that publish step.
pkgname=lightbox-bin
pkgver=0.1.0
pkgrel=1
pkgdesc='Local-first photo manager and non-destructive editor'
arch=('x86_64')
url='https://github.com/asce4s/lightbox'
license=('MIT')
# Linked or dlopen'd by the GPUI binary. Vulkan is loaded at runtime, not via ldd.
depends=(
  'gcc-libs'
  'fontconfig'
  'freetype2'
  'libxkbcommon'
  'wayland'
  'libxcb'
  'libx11'
  'vulkan-icd-loader'
  'hicolor-icon-theme'
)
optdepends=('ffmpeg: video thumbnails and metadata')
provides=('lightbox')
conflicts=('lightbox')
source=("lightbox-${pkgver}-linux-x86_64.tar.gz::https://github.com/asce4s/lightbox/releases/download/v${pkgver}/lightbox-${pkgver}-linux-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
  cd "${srcdir}/lightbox-${pkgver}-linux-x86_64"
  install -Dm755 lightbox "${pkgdir}/usr/bin/lightbox"
  install -Dm755 lightbox-cli "${pkgdir}/usr/bin/lightbox-cli"
  install -Dm644 lightbox.desktop "${pkgdir}/usr/share/applications/lightbox.desktop"
  install -Dm644 lightbox.png "${pkgdir}/usr/share/icons/hicolor/512x512/apps/lightbox.png"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
